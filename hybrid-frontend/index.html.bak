<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <title>TrivietSteel Pro - Quản lý kho & Công trình & Nhà cung cấp</title>
    <link id="app-css" rel="stylesheet" href="/src/styles/css/style.css">
    <link id="mobile-base-css" rel="stylesheet" href="/src/styles/css/mobile/mobile-base.css">
    <link id="mobile-theme-css" rel="stylesheet" href="/src/styles/css/mobile/mobile-theme.css">
    <link id="mobile-transactions-css" rel="stylesheet" href="/src/styles/css/mobile/mobile-transactions.css">
    <link id="mobile-home-css" rel="stylesheet" href="/src/styles/css/mobile/mobile-home.css">
    <link id="mobile-overrides-css" rel="stylesheet" href="/src/styles/css/mobile/mobile-overrides.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
    <script>
      const socket = io();
      socket.on("dataChanged", function(data) {
        console.log("🔄 Data changed:", data);
        window.dispatchEvent(new CustomEvent('dataChanged', { detail: data }));
      });
    </script>
</body>
</html>
